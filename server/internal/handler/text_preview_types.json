{
  "$comment": "Source of truth for text preview allowed types. Edit this file only. The Go side embeds this JSON directly; the TS side is regenerated by `pnpm generate:text-preview-types`.",
  "extensions": [
    "md", "markdown", "txt", "log", "csv", "tsv",
    "html", "htm", "json", "jsonl", "ndjson", "xml",
    "yml", "yaml", "toml", "ini", "conf",
    "dockerfile", "makefile", "gitignore",
    "sh", "bash", "zsh",
    "py", "rb", "go", "rs",
    "ts", "tsx", "js", "jsx", "mjs", "cjs",
    "css", "scss", "sass", "less",
    "sql",
    "java", "kt", "swift",
    "c", "cc", "cpp", "h", "hpp",
    "cs", "php", "lua", "vim"
  ],
  "contentTypes": [
    "application/json",
    "application/x-ndjson",
    "application/javascript",
    "application/xml",
    "application/x-yaml",
    "application/yaml",
    "application/toml",
    "application/x-sh",
    "application/x-httpd-php"
  ],
  "basenames": [
    "dockerfile",
    "makefile",
    ".env",
    ".gitignore"
  ]
}
